# Django
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de données
DATABASE_ENGINE=sqlite
SQLITE_DB_NAME=data/db.sqlite3

# PostgreSQL (optionnel)
# POSTGRES_DB_NAME=decc_vae
# POSTGRES_USER=decc_admin
# POSTGRES_PASSWORD=your_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Internationalisation
LANGUAGE_CODE=fr-fr
TIME_ZONE=Africa/Niamey

# Exports
PDF_ENABLED=True
WORD_ENABLED=True
EXCEL_ENABLED=True

# Logs
LOG_LEVEL=INFO
LOG_FILE=logs/decc_vae.log

# Session (secondes)
SESSION_COOKIE_AGE=3600
